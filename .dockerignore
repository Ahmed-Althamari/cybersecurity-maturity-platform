# Keeps the build context small and, more importantly, keeps real secrets and local
# state out of anything COPY'd into an image layer during the `turbo prune` stage.
node_modules
**/node_modules
**/dist
**/.next
**/coverage
.git
.turbo
**/.turbo
.env
.env.*
!.env.example
*.log
npm-debug.log*
.DS_Store
