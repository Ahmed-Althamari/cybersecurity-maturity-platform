{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.(e2e-spec|integration-spec)\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "babel-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs|@standard-schema|file-type|@tokenizer|strtok3|token-types|uint8array-extras)/)"
  ]
}
