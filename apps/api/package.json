    "@types/jest": "^29.5.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.9.0",
    "@types/passport-jwt": "^3.0.13",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
