{
  "name": "cybersecurity-maturity-platform",
  "version": "0.1.0",
  "description": "Enterprise Cybersecurity Maturity Assessment & Management Platform",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e --filter=@cmmp/api",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npx prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "cd packages/database && npx prisma migrate deploy",
    "db:seed": "npm run build --workspace=@cmmp/framework-engine --workspace=@cmmp/database && cd packages/database && npx prisma db seed",
    "db:studio": "cd packages/database && npx prisma studio",
    "security:audit": "npm audit --audit-level=moderate",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "prettier": "^3.0.2",
    "turbo": "^1.10.16",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "core-js-pure@3.50.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
