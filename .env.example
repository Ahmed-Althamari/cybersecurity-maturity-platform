# Database
DATABASE_URL="postgresql://cmmp_user:cmmp_password@postgres:5432/cmmp_db?schema=public"
DIRECT_DATABASE_URL="postgresql://cmmp_user:cmmp_password@localhost:5432/cmmp_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-min-32-chars-long"

# API Authentication (NestJS)
JWT_SECRET="your-jwt-secret-here-min-32-chars-long"

# API Configuration
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Only needed when apps/web runs in a container (e.g. Docker Compose): the
# NextAuth credentials callback runs server-side inside that container, so
# it must reach the api service by its internal Docker network name, not by
# the browser-facing URL above. Leave unset for native/non-Docker dev --
# NEXT_PUBLIC_API_URL already works for both sides on a single host.
# INTERNAL_API_URL="http://api:3001"

# Application
NODE_ENV="development"
ENVIRONMENT="development"

# Session
SESSION_SECRET="your-session-secret-here"

# Logging
LOG_LEVEL="debug"

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR="/tmp/uploads"

# Security
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (for future use)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"

# AWS/Object Storage (for future)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Observability
SENTRY_DSN=""
LOG_PATH="./logs"

# AI Features (future)
OPENAI_API_KEY=""

# Redis (for caching, future)
REDIS_URL="redis://localhost:6379"
