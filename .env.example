# Database
DATABASE_URL="postgresql://cmmp_user:cmmp_password@postgres:5432/cmmp_db?schema=public"
DIRECT_DATABASE_URL="postgresql://cmmp_user:cmmp_password@localhost:5432/cmmp_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
# These two values (and docker-compose.yml's own fallback defaults) are
# recognized and rejected by apps/web/next.config.js, apps/web/scripts/
# check-env.js, and apps/api/src/config/validate-env.ts: with
# NODE_ENV=production, the API and web app both refuse to start if
# JWT_SECRET/NEXTAUTH_SECRET are unset or still equal to one of these
# placeholders. Generate real values before any non-local deployment, e.g.
# `openssl rand -base64 32`.
NEXTAUTH_SECRET="your-secret-here-min-32-chars-long"

# API Authentication (NestJS)
JWT_SECRET="your-jwt-secret-here-min-32-chars-long"

# API Configuration
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Only needed when apps/web runs in a container (e.g. Docker Compose): the
# NextAuth credentials callback runs server-side inside that container, so
# it must reach the api service by its internal Docker network name, not by
# the browser-facing URL above. Leave unset for native/non-Docker dev --
# NEXT_PUBLIC_API_URL already works for both sides on a single host.
# INTERNAL_API_URL="http://api:3001"

# Application
NODE_ENV="development"
ENVIRONMENT="development"

# Session
SESSION_SECRET="your-session-secret-here"

# Logging
LOG_LEVEL="debug"

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR="/tmp/uploads"

# Security
# Generic, API-wide per-IP request budget (GlobalRateLimitGuard, apps/api/
# src/common/global-rate-limit.guard.ts) -- checked on every request,
# regardless of route or auth status. Separate from and independent of
# login-specific brute-force protection (AUTH_RATE_LIMIT_WINDOW_MS/
# AUTH_RATE_LIMIT_MAX_ATTEMPTS below) -- deliberately not the same
# mechanism or variables, so tuning one doesn't silently affect the other.
# ENABLE_RATE_LIMITING="false" disables this budget in effect.
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login brute-force protection (apps/api/src/auth/auth.module.ts) --
# applied only to POST /auth/login, per IP. Defaults shown are also the
# code's own fallback if these are left unset.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (for future use)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"

# AWS/Object Storage (for future)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Observability
SENTRY_DSN=""
LOG_PATH="./logs"

# AI-assisted import column-mapping (apps/api/src/import/ai-mapping.service.ts).
# Optional: leave unset and the importer falls back to plain exact-header-name
# auto-mapping, unmapped fields left for a human to pick by hand. A
# PLATFORM_ADMIN can also set/replace this live from Settings in the app
# (encrypted at rest -- see SETTINGS_ENCRYPTION_KEY below) without touching
# this file; a database-stored key wins over this one when both are set.
ANTHROPIC_API_KEY=""

# Encrypts any integration secret a PLATFORM_ADMIN sets via the in-app
# Settings page (e.g. the Anthropic API key above) before it's stored in the
# platform_settings table -- required only if that UI is actually used.
# Must be a 32-byte value, base64 or hex encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes any previously-saved secret undecryptable
# (the app falls back to this section's own env vars, if set, rather than
# erroring) -- back it up like any other production secret.
SETTINGS_ENCRYPTION_KEY=""

# AI Features (future, unrelated to ANTHROPIC_API_KEY above)
OPENAI_API_KEY=""

# Redis (for caching, future)
REDIS_URL="redis://localhost:6379"
