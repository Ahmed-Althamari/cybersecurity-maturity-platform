# Database
DATABASE_URL="postgresql://cmmp_user:cmmp_password@postgres:5432/cmmp_db?schema=public"
DIRECT_DATABASE_URL="postgresql://cmmp_user:cmmp_password@localhost:5432/cmmp_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-min-32-chars-long"

# API Authentication (NestJS)
JWT_SECRET="your-jwt-secret-here-min-32-chars-long"

# API Configuration
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Application
NODE_ENV="development"
ENVIRONMENT="development"

# Session
SESSION_SECRET="your-session-secret-here"

# Logging
LOG_LEVEL="debug"

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR="/tmp/uploads"

# Security
ENABLE_RATE_LIMITING="true"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (for future use)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-password"

# AWS/Object Storage (for future)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# Observability
SENTRY_DSN=""
LOG_PATH="./logs"

# AI Features — optional, both features below are additive with a working non-AI fallback:
#   - LLM-assisted column mapping on the assessment Excel/CSV import wizard (apps/api/src/assessments/import-mapping)
#   - "ai" mode on the isolated Data Analysis feature (services/data-analysis) — its "local" mode
#     (AutoViz, zero LLM calls) always works regardless of these
# Slot 1-3 defaults (only FORMAT/BASE_URL/MODEL need overriding to change provider/model — see
# llm-client.ts's SLOT_DEFAULTS): 1) OpenRouter free tier, 2) Groq free tier, 3) Claude (paid).
# Configuring just one slot's API_KEY works; configuring more chains them as an ordered fallback.
LLM_PROVIDER_1_API_KEY=""
LLM_PROVIDER_1_FORMAT=""
LLM_PROVIDER_1_BASE_URL=""
LLM_PROVIDER_1_MODEL=""
LLM_PROVIDER_2_API_KEY=""
LLM_PROVIDER_2_FORMAT=""
LLM_PROVIDER_2_BASE_URL=""
LLM_PROVIDER_2_MODEL=""
LLM_PROVIDER_3_API_KEY=""
LLM_PROVIDER_3_FORMAT=""
LLM_PROVIDER_3_BASE_URL=""
LLM_PROVIDER_3_MODEL=""

# Data Analysis feature (services/data-analysis) — where apps/api reaches the isolated Python
# microservice. The docker-compose default (http://data-analysis:8000) is set automatically inside
# the compose network; override only when running the API outside compose (e.g. local `npm run dev`).
DATA_ANALYSIS_SERVICE_URL="http://localhost:8000"

# Redis (for caching, future)
REDIS_URL="redis://localhost:6379"
