# Builds apps/web (Next.js) from the npm-workspaces monorepo root.
# Build context MUST be the repository root, e.g.:
#   docker build -f infrastructure/Dockerfile.web -t cmmp-web .

FROM node:20-alpine AS builder
WORKDIR /app
COPY . .
RUN npm ci
# @cmmp/database re-exports the generated Prisma Client, so every workspace
# build (including apps/api, built as part of `npm run build` below) fails
# to type-check without it existing first.
RUN npm run db:generate
# `turbo run build` (the root "build" script) resolves the whole workspace
# dependency graph and builds @cmmp/shared before apps/web, per turbo.json's
# "dependsOn": ["^build"]. It also builds apps/api and the other packages,
# which this image doesn't need -- turbo's per-task caching keeps that cheap
# on rebuilds, and it's the same command CI/local dev already use, so there
# is exactly one way this monorepo gets built.
RUN npm run build

# Next's standalone output (output: "standalone" in apps/web/next.config.js)
# traces only the node_modules each page actually needs, so the runtime
# image below never needs the monorepo's full node_modules copied in.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S cmmp && adduser -S cmmp -G cmmp

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

USER cmmp
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/auth/signin || exit 1

CMD ["node", "apps/web/server.js"]
